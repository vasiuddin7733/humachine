# Frontend Vite env (copy to frontend/.env.local for local overrides)

# GitHub Pages project site base path (repo name). Use / for custom domain or local.
VITE_BASE_PATH=/

# Attach backend services (GitHub Pages cannot host these — use free Render/Railway/Fly or local Docker)
VITE_API_GATEWAY_URL=http://127.0.0.1:8001
VITE_CATALOG_SERVICE_URL=http://127.0.0.1:8002
VITE_LISTING_SERVICE_URL=http://127.0.0.1:8003
VITE_PROMOTION_SERVICE_URL=http://127.0.0.1:8004
VITE_WORKER_SERVICE_URL=http://127.0.0.1:8005
